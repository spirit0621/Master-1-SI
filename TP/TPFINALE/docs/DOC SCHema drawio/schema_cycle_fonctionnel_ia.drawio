        <!-- Note d'or -->
        <mxCell id="golden_rule" value="&lt;b&gt;RÈGLE D'OR :&lt;/b&gt; Une réponse non reliée à une preuve technique ou à un Tool est considérée comme nulle et non avenue." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1;fontSize=11;fontColor=#92400E;align=center;" vertex="1" parent="1">
