<mxfile host="app.diagrams.net" modified="2026-09-17T10:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="cycle_ia" name="Cycle Fonctionnel &amp; Décisionnel IA">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titre -->
        <mxCell id="title" value="CYCLE FONCTIONNEL &amp;amp; DÉCISIONNEL DE L'ASSISTANT IA TECHCORP&#xa;Du langage naturel à la réponse structurée probante" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="800" height="50" as="geometry" />
        </mxCell>

        <!-- 1. Question Utilisateur -->
        <mxCell id="node_user" value="&lt;b&gt;1. Opérateur / Technicien&lt;/b&gt;&lt;br&gt;Saisie en langage naturel&lt;br&gt;&lt;i&gt;« SRV-DB-01 fonctionne-t-il réellement ? »&lt;/i&gt;" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="140" height="150" as="geometry" />
        </mxCell>

        <!-- 2. Application IA & Client MCP -->
        <mxCell id="node_app" value="&lt;b&gt;2. Application IA &amp;amp; Client MCP&lt;/b&gt;&lt;br&gt;Interface Streamlit (:8501)&lt;br&gt;Orchestrateur Python (&lt;i&gt;llm_engine.py&lt;/i&gt;)&lt;br&gt;Envoi prompt système + schémas Tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="270" y="180" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- 3. LLM Local Ollama Qwen -->
        <mxCell id="node_llm" value="&lt;b&gt;3. LLM Local (Ollama Qwen 4B)&lt;/b&gt;&lt;br&gt;Analyse sémantique de la requête&lt;br&gt;Détection d'un besoin de vérification&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;Émission tool_call (Pas d'invention)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="560" y="180" width="230" height="110" as="geometry" />
        </mxCell>

        <!-- 4. Serveur MCP FastMCP -->
        <mxCell id="node_mcp" value="&lt;b&gt;4. Serveur MCP (FastMCP)&lt;/b&gt;&lt;br&gt;Réception et validation des paramètres&lt;br&gt;Contrôle liste blanche &amp;amp; sécurité&lt;br&gt;Routage vers le bon connecteur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontSize=11;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="860" y="180" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Sources SI -->
        <mxCell id="box_sources" value="5. SOURCES DU SI TECHCORP" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="1150" y="90" width="220" height="340" as="geometry" />
        </mxCell>

        <mxCell id="src_db" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;Inventaire serveurs, services, logs récents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=10;fontColor=#064E3B;" vertex="1" parent="box_sources">
          <mxGeometry x="20" y="40" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="src_api" value="&lt;b&gt;FastAPI Tickets&lt;/b&gt;&lt;br&gt;Incidents ouverts, priorité, descriptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=10;fontColor=#991B1B;" vertex="1" parent="box_sources">
          <mxGeometry x="20" y="110" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="src_net" value="&lt;b&gt;Sonde Réseau TCP&lt;/b&gt;&lt;br&gt;Mesure réelle temps réel par socket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#D97706;fontSize=10;fontColor=#78350F;" vertex="1" parent="box_sources">
          <mxGeometry x="20" y="180" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="src_res" value="&lt;b&gt;Resources MCP&lt;/b&gt;&lt;br&gt;Procédures DNS &amp;amp; Escalade d'incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontSize=10;fontColor=#312E81;" vertex="1" parent="box_sources">
          <mxGeometry x="20" y="250" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- 6. Contexte Enrichi & Provenance -->
        <mxCell id="node_context" value="&lt;b&gt;6. Contexte Structuré &amp;amp; Traçabilité&lt;/b&gt;&lt;br&gt;Résultats techniques bruts + Horodatage + Source&lt;br&gt;Enregistrement immédiat dans &lt;i&gt;logs/techcorp_calls.jsonl&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="720" y="380" width="360" height="80" as="geometry" />
        </mxCell>

        <!-- 7. Détection de Contradiction -->
        <mxCell id="node_decision" value="&lt;b&gt;7. Analyse Critique &amp;amp; Contradiction&lt;/b&gt;&lt;br&gt;Confrontation : &lt;i&gt;Inventaire statique (UP)&lt;/i&gt;&lt;br&gt;&lt;b&gt;VS&lt;/b&gt; &lt;i&gt;Sonde temps réel (SERVICE_DOWN)&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;&lt;b&gt;Alerte formelle requise !&lt;/b&gt;&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=11;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="380" y="340" width="260" height="150" as="geometry" />
        </mxCell>

        <!-- 8. Restitution 3 Volets -->
        <mxCell id="node_output" value="&lt;b&gt;8. Restitution Structurée à l'Utilisateur&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;font-size:10px;text-align:left;width:100%;margin-top:5px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;color:#1E3A8A;&quot;&gt;&lt;b&gt;1. FAITS :&lt;/b&gt;&lt;/td&gt;&lt;td&gt;SRV-DB-01 déclaré UP en CMDB (IP 192.168.56.20)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#B45309;&quot;&gt;&lt;b&gt;2. VÉRIFICATION :&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Port 5432 inaccessible en socket TCP (SERVICE_DOWN)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#065F46;&quot;&gt;&lt;b&gt;3. RECOMMANDATION :&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Vérifier le service PostgreSQL avant de rebooter la VM&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontSize=11;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="1310" height="90" as="geometry" />
        </mxCell>

        <!-- Liens -->
