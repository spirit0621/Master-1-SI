                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_tnet_targets" value="Socket TCP&#10;connect(IP, port)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#D97706;fontColor=#78350F;fontSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="t_net" target="b_targets" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="table_comp" value="&lt;b&gt;BILAN COMPARATIF TECHNIQUE DES CANAUX D'ACCÈS :&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;font-size:11px;width:100%;border-collapse:collapse;margin-top:5px;&quot;&gt;&lt;tr style=&quot;background-color:#E2E8F0;&quot;&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;Critère&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;Accès Direct PostgreSQL (get_server_info)&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;Accès API Métier FastAPI (list_open_tickets)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;&lt;b&gt;Latence brute&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;color:#047857;&quot;&gt;&lt;b&gt;Ultra-rapide (&amp;lt; 3 ms)&lt;/b&gt; — Pas d'overhead HTTP&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;Légèrement plus élevée (~12 ms) due à la pile HTTP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;&lt;b&gt;Couplage&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;color:#B91C1C;&quot;&gt;Couplage fort au schéma relationnel SQL&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;color:#047857;&quot;&gt;&lt;b&gt;Découplage total&lt;/b&gt; via contrats d'API JSON Pydantic&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;&lt;b&gt;Sécurité &amp;amp; RBAC&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;Restreint par utilisateur PostgreSQL (SELECT seul)&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;color:#047857;&quot;&gt;&lt;b&gt;Contrôle applicatif granulaire&lt;/b&gt;, middleware &amp;amp; rate-limiting&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="50" y="600" width="1300" height="120" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
