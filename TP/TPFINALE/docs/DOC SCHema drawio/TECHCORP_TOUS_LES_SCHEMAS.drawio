                <mxCell id="node_decision" value="&lt;b&gt;7. Analyse Critique &amp;amp; Contradiction&lt;/b&gt;&lt;br&gt;Confrontation : &lt;i&gt;Inventaire statique (UP)&lt;/i&gt;&lt;br&gt;&lt;b&gt;VS&lt;/b&gt; &lt;i&gt;Sonde temps réel (SERVICE_DOWN)&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;&lt;b&gt;Alerte formelle requise !&lt;/b&gt;&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=11;fontColor=#7F1D1D;" parent="1" vertex="1">
