                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_client_mcp" value="Protocole MCP&#10;(JSON-RPC)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#2563EB;fontColor=#1D4ED8;fontSize=11;" parent="1" source="client_engine" target="box_mcp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_tdb_db" value="TCP Wire :5432&#10;Direct SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#059669;fontColor=#064E3B;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="t_db" target="b_db" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
