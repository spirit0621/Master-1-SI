                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="box_mcp" value="2. COUCHE SERVEUR MCP (FastMCP : mcp_server/server.py)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#92400E;" parent="1" vertex="1">
                    <mxGeometry x="450" y="90" width="460" height="480" as="geometry"/>
                </mxCell>
                <mxCell id="t_db" value="&lt;b&gt;Canal 1 : get_server_info(hostname)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;&lt;b&gt;&amp;rarr; ACCÈS DIRECT BASE RELATIONNELLE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Requête SQL paramétrée sur table &lt;i&gt;servers&lt;/i&gt;&lt;br&gt;Zéro intermédiaire, latence minimale (&amp;lt; 5ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#064E3B;align=left;spacingLeft=10;" parent="box_mcp" vertex="1">
                    <mxGeometry x="25" y="45" width="410" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t_api" value="&lt;b&gt;Canal 2 : list_open_tickets(priority=None)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;&lt;b&gt;&amp;rarr; CONSOMMATION API MÉTIER REST&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Requête HTTP GET sur &lt;i&gt;http://192.168.56.10:8000/tickets/open&lt;/i&gt;&lt;br&gt;Validation Pydantic, règles de gestion métier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontSize=11;fontColor=#991B1B;align=left;spacingLeft=10;" parent="box_mcp" vertex="1">
                    <mxGeometry x="25" y="155" width="410" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t_net" value="&lt;b&gt;Canal 3 : check_server_availability(hostname)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;&amp;rarr; MESURE RÉSEAU ACTIVE (SOCKET TCP)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Ouverture de socket vers IP &amp;amp; Port du service avec timeout 2s&lt;br&gt;Distinction formelle entre CMDB et Temps Réel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#78350F;align=left;spacingLeft=10;" parent="box_mcp" vertex="1">
                    <mxGeometry x="25" y="265" width="410" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="t_action" value="&lt;b&gt;Tool Avancé : create_ticket(confirm=True)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;&lt;b&gt;&amp;rarr; SÉCURITÉ : CONFIRMATION HUMAINE REQUISE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Si confirm=False &amp;rarr; refus et demande de validation&lt;br&gt;Si confirm=True &amp;rarr; HTTP POST /tickets vers FastAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1;fontSize=10;fontColor=#4C1D95;align=left;spacingLeft=10;" parent="box_mcp" vertex="1">
                    <mxGeometry x="25" y="375" width="410" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="box_backend" value="3. COUCHE SERVICES, PERSISTANCE &amp;amp; CIBLES" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#334155;" parent="1" vertex="1">
                    <mxGeometry x="980" y="90" width="370" height="480" as="geometry"/>
                </mxCell>
                <mxCell id="b_db" value="&lt;b&gt;Base PostgreSQL 16 (SRV-DB-01)&lt;/b&gt;&lt;br&gt;Port TCP :5432&lt;br&gt;Tables &lt;i&gt;servers&lt;/i&gt;, &lt;i&gt;services&lt;/i&gt;, &lt;i&gt;events&lt;/i&gt;&lt;br&gt;Utilisateur dédié : &lt;b&gt;techapp&lt;/b&gt; (SELECT)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#064E3B;" parent="box_backend" vertex="1">
                    <mxGeometry x="30" y="40" width="310" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b_fastapi" value="&lt;b&gt;API FastAPI (SRV-APP-01)&lt;/b&gt;&lt;br&gt;Port TCP :8000&lt;br&gt;Middleware de logging, validation Pydantic&lt;br&gt;End-points /tickets/open et /tickets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontSize=11;fontColor=#991B1B;" parent="box_backend" vertex="1">
                    <mxGeometry x="30" y="170" width="310" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="b_targets" value="&lt;b&gt;Cibles Réseau Physiques&lt;/b&gt;&lt;br&gt;&amp;bull; SRV-WEB-01 (192.168.56.30:80 Nginx)&lt;br&gt;&amp;bull; SRV-DB-01 (192.168.56.20:5432 PG)&lt;br&gt;&amp;bull; SRV-DNS-01 (192.168.56.53:53 Bind9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#D97706;strokeWidth=1;fontSize=10;fontColor=#78350F;" parent="box_backend" vertex="1">
                    <mxGeometry x="30" y="280" width="310" height="80" as="geometry"/>
                </mxCell>
