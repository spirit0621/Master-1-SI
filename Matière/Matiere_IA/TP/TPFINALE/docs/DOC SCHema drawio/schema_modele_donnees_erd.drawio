        <!-- Légende / Note -->
        <mxCell id="erd_legend" value="&lt;b&gt;Caractéristiques d'Intégrité Référentielle :&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Clés Primaires :&lt;/b&gt; &lt;i&gt;hostname&lt;/i&gt; sur SERVERS, &lt;i&gt;id SERIAL&lt;/i&gt; auto-incrémenté sur les tables d'activités.&lt;br&gt;&amp;bull; &lt;b&gt;Intégrité Référentielle :&lt;/b&gt; Suppression en cascade &lt;i&gt;ON DELETE CASCADE&lt;/i&gt; pour SERVICES et SERVICE_CHECKS ; &lt;i&gt;ON DELETE SET NULL&lt;/i&gt; pour TICKETS et EVENTS.&lt;br&gt;&amp;bull; &lt;b&gt;Index de Performance :&lt;/b&gt; &lt;i&gt;idx_tickets_status&lt;/i&gt;, &lt;i&gt;idx_tickets_priority&lt;/i&gt;, &lt;i&gt;idx_service_checks_hostname&lt;/i&gt;, &lt;i&gt;idx_events_hostname_level&lt;/i&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
