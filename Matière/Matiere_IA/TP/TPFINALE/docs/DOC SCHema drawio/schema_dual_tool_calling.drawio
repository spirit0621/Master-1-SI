<mxfile host="app.diagrams.net" modified="2026-09-17T10:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="dual_mcp" name="Dual Tool Calling MCP">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titre -->
        <mxCell id="title" value="ARCHITECTURE DUAL TOOL CALLING MCP : ACCÈS DIRECT DB vs API REST&#xa;Comparaison des canaux de communication et de persistance" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="900" height="50" as="geometry" />
        </mxCell>

        <!-- COUCHE ORCHESTRATION -->
        <mxCell id="box_orch" value="1. COUCHE ORCHESTRATION &amp;amp; CLIENT MCP (POSTE-ETU)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="340" height="480" as="geometry" />
        </mxCell>

        <mxCell id="client_ui" value="&lt;b&gt;Streamlit UI (:8501)&lt;/b&gt;&lt;br&gt;Saisie question &amp;amp; choix démo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="box_orch">
          <mxGeometry x="30" y="50" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="client_engine" value="&lt;b&gt;Orchestrateur Python (llm_engine.py)&lt;/b&gt;&lt;br&gt;Boucle d'appel d'outils (Tool Calling Loop)&lt;br&gt;Extraction arguments &amp;amp; réinjection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#1D4ED8;fontSize=11;fontColor=#1E3A8A;" vertex="1" parent="box_orch">
          <mxGeometry x="30" y="150" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="client_llm" value="&lt;b&gt;LLM Ollama (qwen3:4b)&lt;/b&gt;&lt;br&gt;Port :11434&lt;br&gt;Génération de l'intention de Tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontSize=11;fontColor=#312E81;" vertex="1" parent="box_orch">
          <mxGeometry x="30" y="270" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e_ui_eng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#2563EB;" edge="1" parent="box_orch" source="client_ui" target="client_engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_eng_llm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#4338CA;" edge="1" parent="box_orch" source="client_engine" target="client_llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- COUCHE FASTMCP -->
        <mxCell id="box_mcp" value="2. COUCHE SERVEUR MCP (FastMCP : mcp_server/server.py)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="450" y="90" width="460" height="480" as="geometry" />
        </mxCell>

        <!-- Tool 1 Direct DB -->
        <mxCell id="t_db" value="&lt;b&gt;Canal 1 : get_server_info(hostname)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;&lt;b&gt;&amp;rarr; ACCÈS DIRECT BASE RELATIONNELLE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Requête SQL paramétrée sur table &lt;i&gt;servers&lt;/i&gt;&lt;br&gt;Zéro intermédiaire, latence minimale (&amp;lt; 5ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#064E3B;align=left;spacingLeft=10;" vertex="1" parent="box_mcp">
          <mxGeometry x="25" y="45" width="410" height="85" as="geometry" />
        </mxCell>

        <!-- Tool 2 API REST -->
        <mxCell id="t_api" value="&lt;b&gt;Canal 2 : list_open_tickets(priority=None)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;&lt;b&gt;&amp;rarr; CONSOMMATION API MÉTIER REST&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Requête HTTP GET sur &lt;i&gt;http://192.168.56.10:8000/tickets/open&lt;/i&gt;&lt;br&gt;Validation Pydantic, règles de gestion métier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontSize=11;fontColor=#991B1B;align=left;spacingLeft=10;" vertex="1" parent="box_mcp">
          <mxGeometry x="25" y="155" width="410" height="85" as="geometry" />
        </mxCell>

        <!-- Tool 3 TCP Probe -->
        <mxCell id="t_net" value="&lt;b&gt;Canal 3 : check_server_availability(hostname)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;&amp;rarr; MESURE RÉSEAU ACTIVE (SOCKET TCP)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Ouverture de socket vers IP &amp;amp; Port du service avec timeout 2s&lt;br&gt;Distinction formelle entre CMDB et Temps Réel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#78350F;align=left;spacingLeft=10;" vertex="1" parent="box_mcp">
          <mxGeometry x="25" y="265" width="410" height="85" as="geometry" />
        </mxCell>

        <!-- Tool 4 Action avec Confirmation -->
        <mxCell id="t_action" value="&lt;b&gt;Tool Avancé : create_ticket(confirm=True)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;&lt;b&gt;&amp;rarr; SÉCURITÉ : CONFIRMATION HUMAINE REQUISE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Si confirm=False &amp;rarr; refus et demande de validation&lt;br&gt;Si confirm=True &amp;rarr; HTTP POST /tickets vers FastAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1;fontSize=10;fontColor=#4C1D95;align=left;spacingLeft=10;" vertex="1" parent="box_mcp">
          <mxGeometry x="25" y="375" width="410" height="80" as="geometry" />
        </mxCell>

        <!-- COUCHE SERVICES & DONNÉES -->
        <mxCell id="box_backend" value="3. COUCHE SERVICES, PERSISTANCE &amp;amp; CIBLES" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="980" y="90" width="370" height="480" as="geometry" />
        </mxCell>

        <mxCell id="b_db" value="&lt;b&gt;Base PostgreSQL 16 (SRV-DB-01)&lt;/b&gt;&lt;br&gt;Port TCP :5432&lt;br&gt;Tables &lt;i&gt;servers&lt;/i&gt;, &lt;i&gt;services&lt;/i&gt;, &lt;i&gt;events&lt;/i&gt;&lt;br&gt;Utilisateur dédié : &lt;b&gt;techapp&lt;/b&gt; (SELECT)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#064E3B;" vertex="1" parent="box_backend">
          <mxGeometry x="30" y="40" width="310" height="100" as="geometry" />
        </mxCell>

        <mxCell id="b_fastapi" value="&lt;b&gt;API FastAPI (SRV-APP-01)&lt;/b&gt;&lt;br&gt;Port TCP :8000&lt;br&gt;Middleware de logging, validation Pydantic&lt;br&gt;End-points /tickets/open et /tickets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontSize=11;fontColor=#991B1B;" vertex="1" parent="box_backend">
          <mxGeometry x="30" y="170" width="310" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b_targets" value="&lt;b&gt;Cibles Réseau Physiques&lt;/b&gt;&lt;br&gt;&amp;bull; SRV-WEB-01 (192.168.56.30:80 Nginx)&lt;br&gt;&amp;bull; SRV-DB-01 (192.168.56.20:5432 PG)&lt;br&gt;&amp;bull; SRV-DNS-01 (192.168.56.53:53 Bind9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#D97706;strokeWidth=1;fontSize=10;fontColor=#78350F;" vertex="1" parent="box_backend">
          <mxGeometry x="30" y="280" width="310" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e_fastapi_db" value="Persistance SQL :5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#EF4444;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="box_backend" source="b_fastapi" target="b_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LIENS INTER-COUCHES -->
        <!-- Client MCP -> Serveur MCP -->
        <mxCell id="e_client_mcp" value="Protocole MCP&#xa;(JSON-RPC)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#2563EB;fontColor=#1D4ED8;fontSize=11;" edge="1" parent="1" source="client_engine" target="box_mcp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- T_DB -> B_DB -->
        <mxCell id="e_tdb_db" value="TCP Wire :5432&#xa;Direct SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#059669;fontColor=#064E3B;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_db" target="b_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- T_API -> B_FASTAPI -->
        <mxCell id="e_tapi_api" value="HTTP GET :8000&#xa;/tickets/open" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#EF4444;fontColor=#991B1B;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_api" target="b_fastapi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- T_NET -> B_TARGETS -->
        <mxCell id="e_tnet_targets" value="Socket TCP&#xa;connect(IP, port)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#D97706;fontColor=#78350F;fontSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_net" target="b_targets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Tableau comparatif -->
        <mxCell id="table_comp" value="&lt;b&gt;BILAN COMPARATIF TECHNIQUE DES CANAUX D'ACCÈS :&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;font-size:11px;width:100%;border-collapse:collapse;margin-top:5px;&quot;&gt;&lt;tr style=&quot;background-color:#E2E8F0;&quot;&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;Critère&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;Accès Direct PostgreSQL (get_server_info)&lt;/th&gt;&lt;th style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;Accès API Métier FastAPI (list_open_tickets)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;&lt;b&gt;Latence brute&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;color:#047857;&quot;&gt;&lt;b&gt;Ultra-rapide (&amp;lt; 3 ms)&lt;/b&gt; — Pas d'overhead HTTP&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;Légèrement plus élevée (~12 ms) due à la pile HTTP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;&lt;b&gt;Couplage&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;color:#B91C1C;&quot;&gt;Couplage fort au schéma relationnel SQL&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;color:#047857;&quot;&gt;&lt;b&gt;Découplage total&lt;/b&gt; via contrats d'API JSON Pydantic&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;&lt;b&gt;Sécurité &amp;amp; RBAC&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;&quot;&gt;Restreint par utilisateur PostgreSQL (SELECT seul)&lt;/td&gt;&lt;td style=&quot;border:1px solid #CBD5E1;padding:4px;color:#047857;&quot;&gt;&lt;b&gt;Contrôle applicatif granulaire&lt;/b&gt;, middleware &amp;amp; rate-limiting&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="1300" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
