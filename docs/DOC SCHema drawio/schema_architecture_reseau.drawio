          <mxGeometry x="40" y="150" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- FLUX INTER-ZONES -->
        <!-- Client MCP -> Serveur MCP -->
        <mxCell id="flux_client_mcp" value="Protocole MCP&#xa;(STDIO ou HTTP SSE :8080)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#2563EB;fontColor=#1D4ED8;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="orchestrator_box" target="mcp_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Serveur MCP -> Direct PostgreSQL -->
