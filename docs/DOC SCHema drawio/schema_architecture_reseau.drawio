        <!-- ZONE APPLICATIVE -->
        <mxCell id="zone_app" value="ZONE APPLICATIVE (SRV-APP-01 : 192.168.56.10)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#92400E;" vertex="1" parent="1">
