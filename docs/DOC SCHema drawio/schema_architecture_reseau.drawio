        <mxCell id="mcp_box" value="&lt;b&gt;Serveur MCP (FastMCP)&lt;/b&gt;&lt;br&gt;Port :8080 ou STDIO&lt;br&gt;&lt;i&gt;mcp_server/server.py&lt;/i&gt;&lt;br&gt;&lt;ul style=&quot;margin:0;padding-left:15px;text-align:left;&quot;&gt;&lt;li&gt;get_server_info(hostname)&lt;/li&gt;&lt;li&gt;list_open_tickets(priority)&lt;/li&gt;&lt;li&gt;get_recent_events(hostname)&lt;/li&gt;&lt;li&gt;check_server_availability(hostname)&lt;/li&gt;&lt;li&gt;get_last_service_check(hostname)&lt;/li&gt;&lt;li&gt;create_ticket(confirm=True)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#78350F;" vertex="1" parent="zone_app">
