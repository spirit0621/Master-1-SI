          <mxGeometry x="960" y="410" width="460" height="270" as="geometry" />
        </mxCell>

        <mxCell id="target_web" value="&lt;b&gt;SRV-WEB-01 (192.168.56.30)&lt;/b&gt;&lt;br&gt;&amp;bull; Nginx Web Server (TCP :80)&lt;br&gt;&amp;bull; SSH Administration (TCP :22)&lt;br&gt;&lt;i&gt;Cible de sonde réseau TCP&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;strokeWidth=2;fontSize=11;fontColor=#1E293B;" vertex="1" parent="zone_cibles">
