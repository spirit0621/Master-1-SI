        <!-- ZONE DONNÉES -->
        <mxCell id="zone_data" value="ZONE DONNÉES (SRV-DB-01 : 192.168.56.20)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="460" height="280" as="geometry" />
        </mxCell>

        <mxCell id="pg_box" value="&lt;b&gt;Base Relationnelle PostgreSQL 16&lt;/b&gt;&lt;br&gt;Port TCP :5432&lt;br&gt;Base : &lt;i&gt;techcorp&lt;/i&gt; | Utilisateur : &lt;i&gt;techapp&lt;/i&gt;&lt;br&gt;&lt;hr&gt;&lt;table style=&quot;font-size:10px;text-align:left;width:100%;&quot;&gt;&lt;tr&gt;&lt;td&gt;&amp;bull; &lt;b&gt;servers&lt;/b&gt; (inventaire)&lt;/td&gt;&lt;td&gt;&amp;bull; &lt;b&gt;service_checks&lt;/b&gt; (sondes)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&amp;bull; &lt;b&gt;services&lt;/b&gt; (ports)&lt;/td&gt;&lt;td&gt;&amp;bull; &lt;b&gt;events&lt;/b&gt; (logs parsés)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&amp;bull; &lt;b&gt;tickets&lt;/b&gt; (incidents)&lt;/td&gt;&lt;td&gt;&amp;bull; &lt;b&gt;ingestion_audit&lt;/b&gt; (ETL)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#064E3B;" vertex="1" parent="zone_data">
          <mxGeometry x="40" y="50" width="380" height="200" as="geometry" />
        </mxCell>

        <!-- ZONE CIBLES RÉSEAU -->
