        <mxCell id="fastapi_box" value="&lt;b&gt;API Métier FastAPI&lt;/b&gt;&lt;br&gt;Port :8000&lt;br&gt;&lt;i&gt;api/main.py&lt;/i&gt;&lt;br&gt;&lt;ul style=&quot;margin:0;padding-left:15px;text-align:left;&quot;&gt;&lt;li&gt;GET /health&lt;/li&gt;&lt;li&gt;GET /tickets&lt;/li&gt;&lt;li&gt;GET /tickets/open&lt;/li&gt;&lt;li&gt;POST /tickets&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontSize=11;fontColor=#991B1B;" vertex="1" parent="zone_app">
