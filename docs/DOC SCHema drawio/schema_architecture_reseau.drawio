        <!-- FastAPI -> PostgreSQL -->
        <mxCell id="flux_api_db" value="SQL Persistance :5432&#xa;(Tickets d'incidents)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="fastapi_box" target="pg_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Serveur MCP -> Sondes Réseau TCP -->
        <mxCell id="flux_mcp_probe_web" value="Sonde Socket TCP :80 / :22&#xa;(check_server_availability)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D97706;fontColor=#92400E;fontSize=10;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mcp_box" target="target_web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="flux_mcp_probe_db" value="Sonde Socket TCP :5432&#xa;(Validation réelle disponibilité)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D97706;fontColor=#92400E;fontSize=10;dashed=1;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="mcp_box" target="pg_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Légende / Sécurité -->
        <mxCell id="legend_box" value="&lt;b&gt;Légende &amp;amp; Règles de Sécurité Appliquées :&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;font color=&quot;#2563EB&quot;&gt;&lt;b&gt;&amp;mdash; Flux MCP :&lt;/b&gt;&lt;/font&gt; Échange structuré standardisé JSON-RPC&lt;br&gt;&amp;bull; &lt;font color=&quot;#059669&quot;&gt;&lt;b&gt;&amp;mdash; Flux Direct DB :&lt;/b&gt;&lt;/font&gt; Lecture seule directe (SELECT) sur tables d'inventaire&lt;br&gt;&amp;bull; &lt;font color=&quot;#EF4444&quot;&gt;&lt;b&gt;&amp;mdash; Flux API REST :&lt;/b&gt;&lt;/font&gt; Encapsulation métier et contrôle d'accès sur tickets&lt;br&gt;&amp;bull; &lt;font color=&quot;#D97706&quot;&gt;&lt;b&gt;- - Sonde TCP :&lt;/b&gt;&lt;/font&gt; Test temps réel par tentative de socket avec timeout 2.0s&lt;br&gt;&amp;bull; &lt;b&gt;Cloisonnement :&lt;/b&gt; Port 5432 fermé à l'extérieur, accessible uniquement par SRV-APP-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="710" width="1360" height="90" as="geometry" />
        </mxCell>

