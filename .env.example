# ==============================================================================
# Configuration Environnement TECHCORP - Modèle d'exemple (.env.example)
# Copier ce fichier vers .env et renseigner les valeurs réelles.
# NE JAMAIS COMMITER LE FICHIER .env DANS LE DÉPÔT GIT !
# ==============================================================================

# --- Base de données PostgreSQL (SRV-DB-01) ---
POSTGRES_HOST=192.168.56.20
POSTGRES_PORT=5432
POSTGRES_DB=techcorp
POSTGRES_USER=techapp
POSTGRES_PASSWORD=TechCorp2026_SecurePwd!

# --- API Métier FastAPI (SRV-APP-01) ---
FASTAPI_HOST=192.168.56.10
FASTAPI_PORT=8000
FASTAPI_URL=http://192.168.56.10:8000

# --- Serveur MCP (SRV-APP-01) ---
MCP_HOST=192.168.56.10
MCP_PORT=8080
MCP_TRANSPORT=stdio

# --- Runtime LLM Local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Serveur Cible de Test Réseau (SRV-WEB-01) ---
TARGET_WEB_HOST=192.168.56.30
TARGET_WEB_PORT=80
TARGET_SSH_PORT=22

# --- Journalisation & Observabilité ---
LOG_LEVEL=INFO
LOG_FILE=app/logs/techcorp_calls.jsonl
